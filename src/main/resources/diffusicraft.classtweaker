classTweaker	v1	official
# ClimateBiomeSource extends the multi-noise source, so mods that look for one still find it.
accessible	method	net/minecraft/world/level/biome/MultiNoiseBiomeSource	<init>	(Lcom/mojang/datafixers/util/Either;)V
# Shared single-value container data (height/SharedContainerData).
accessible	class	net/minecraft/world/level/chunk/PalettedContainer$Data
accessible	method	net/minecraft/world/level/chunk/PalettedContainer$Data	<init>	(Lnet/minecraft/world/level/chunk/Configuration;Lnet/minecraft/util/BitStorage;Lnet/minecraft/world/level/chunk/Palette;)V
