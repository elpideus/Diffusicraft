{
  "type": "diffusicraft:world",
  "rule": {
    "type": "minecraft:sequence",
    "sequence": [
      "diffusicraft:minecraft/bedrock_floor",
      {
        "type": "diffusicraft:river",
        "scale": "grand"
      },
      "diffusicraft:minecraft/overworld/copper_ore_vein",
      "diffusicraft:minecraft/overworld/iron_ore_vein",
      {
        "type": "diffusicraft:strata",
        "scale": "grand",
        "surface": {
          "type": "minecraft:sequence",
          "sequence": [
            {
              "type": "diffusicraft:other_mods",
              "rule": {
                "type": "minecraft:condition",
                "if_true": {
                  "type": "minecraft:above_preliminary_surface"
                },
                "then_run": "minecraft:overworld/surface"
              }
            },
            {
              "type": "minecraft:condition",
              "if_true": {
                "type": "minecraft:above_preliminary_surface"
              },
              "then_run": {
                "type": "minecraft:sequence",
                "sequence": [
                  "diffusicraft:biome_surface",
                  "diffusicraft:minecraft/overworld/surface"
                ]
              }
            },
            {
              "type": "minecraft:condition",
              "if_true": {
                "type": "minecraft:biome",
                "biome_is": "minecraft:sulfur_caves"
              },
              "then_run": "diffusicraft:minecraft/overworld/sulfur_cave_bands"
            },
            "diffusicraft:biome_caves"
          ]
        }
      }
    ]
  }
}
